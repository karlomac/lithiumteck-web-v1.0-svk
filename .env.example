# Reverse proxy / SvelteKit (adapter-node behind Traefik/Dokploy)
# PROTOCOL_HEADER/HOST_HEADER are set in compose for proxy-trusted origin; set ORIGIN only if needed.
ORIGIN=
XFF_DEPTH=1

# PocketBase Configuration (External - deployed separately)
POCKETBASE_URL=https://your-pocketbase-instance.com

# OAuth Providers (Optional)
POCKETBASE_GOOGLE_CLIENT_ID=
POCKETBASE_GOOGLE_CLIENT_SECRET=
POCKETBASE_GITHUB_CLIENT_ID=
POCKETBASE_GITHUB_CLIENT_SECRET=

# Application Settings
PUBLIC_SITE_URL=https://your-domain.example
PUBLIC_SITE_NAME=Lithiumteck
PUBLIC_SITE_DESCRIPTION=Premium world building, high-performance custom plugins, and immersive asset design for the next generation of Minecraft servers.

# Email Configuration (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
